 <LayoutItem background="false" blendMode="0" excludeFromExports="0" frame="false" frameJoinStyle="miter" groupUuid="" halign="1" htmlState="0" id="" itemRotation="0" labelText="Paddle: geographic water-path distance, plus 15-30% indirect travel;&#xa;20-35% on more winding paths. Divide by 4 km/h (favourable) or&#xa;2 km/h (adverse but travelable). These are teaching assumptions.&#xa;&#xa;Carry: 2 loaded walks at 2-3 km/h, 1 return at 3-4 km/h,&#xa;plus 10-20 minutes of handling per connection. One rod = 5.0292 m.&#xa;&#xa;Bounds round outward to quarter hours. A 0-0.25 h label means&#xa;a brief nonzero leg. All rod counts are derived, not official counts." marginX="0" marginY="0" opacity="1" outlineWidthM="0.3,mm" position="15,197,mm" positionLock="false" positionOnPage="15,197,mm" referencePoint="0" size="246,61,mm" templateUuid="{44f504c4-d674-42ec-85c2-2d551223d5b8}" type="65641" uuid="{44f504c4-d674-42ec-85c2-2d551223d5b8}" valign="32" visibility="1" zValue="14">
  <FrameColor alpha="255" blue="0" green="0" red="0"/>
  <BackgroundColor alpha="255" blue="255" green="255" red="255"/>
  <LayoutObject>
