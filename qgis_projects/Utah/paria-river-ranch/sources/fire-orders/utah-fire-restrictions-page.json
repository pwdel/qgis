e":"markdown-card","settings":{"cardId":"cs39vmbf6","schemaVersion":2.1,"markdown":"<p><br></p>"}},"width":12}]}],"visibility":{"access":"default","groups":[]}},{"containment":"fixed","isFooter":false,"style":{"background":{"isFile":false,"isUrl":true,"state":"","display":{},"transparency":0,"position":{"x":"center","y":"center"},"color":"#fedd00"},"rowLayout":"box"},"rows":[{"cards":[{"component":{"name":"markdown-card","settings":{"cardId":"ciq4jcc95","schemaVersion":2.1,"markdown":"<h1 style=\"text-align: center; color:black; font-size: 3rem;\">Current Fire Restriction Orders</h1>"}},"width":12}]}],"visibility":{"access":"default","groups":[]}},{"containment":"fixed","isFooter":false,"style":{"background":{"isFile":false,"isUrl":true,"state":"","display":{},"transparency":0,"position":{"x":"center","y":"center"},"color":"#ffffff"},"rowLayout":"box","color":"#f0ecd4"},"rows":[{"cards":[{"component":{"name":"markdown-card","settings":{"cardId":"cvld1i187","schemaVersion":2.1,"markdown":"\n\n\n\n\n\n<style>\n\n@import url('https://fonts.googleapis.com/css2?family=Archivo+Black&display=swap');\nh5{\n  font-family: Poppins;\n  font-weight: bold;\n  font-size: .9rem;\n  margin-top: 1px;\n  color: black;\n}\n/*F3AB00-orange    \n322D41-dark purple\nF0ECD4-Ivory\nFEDD00-yellow\nFF3719-red*/\ncalcite-accordion-item a{\n  color: #FFFDF3;\n}\ncalcite-accordion-item.headingPanel{\n  background-color:#322D41;\n  font-family:Archivo Black; !important\n  margin-bottom: 8px;\n  border-bottom: 1px solid rgb(128, 128, 128);\n  --calcite-ui-text-1: #FFFDF3;\n  --calcite-ui-text-2: #F0ECD4;\n  --calcite-ui-text-3: #F0ECD4;\n}\ncalcite-accordion {\n  --calcite-accordion-item-heading-text-color: #F0ECD4;\n}\n\n.panel-body{\n  background-color:#F0ECD4;\n  color: black; !important\n  font-family: Poppins;\n  font-size: .8em;\n  padding-top: 6px;\n}\n.panel-body a{\n  color: #FF3719;\n}\n</style>\n\n\n\n\n\n<div><div class=\"col-xs-12\"><calcite-accordion appearance=\"transparent\" icon-position=\"start\" scale=\"l\" selection-mode=\"single\" icon-type=\"chevron\" calcite-hydrated=\"\">\n         <calcite-accordion-item heading=\"Statewide Restrictions\" class=\"headingPanel\" calcite-hydrated=\"\" scale=\"l\" expanded=\"\"><div class=\"panel-body\"><span style=\"font-size: 12.8px; font-weight: 600;\">See areas below, for individual restrictions covering portions of the state.</span></div><div class=\"panel-body\"><span style=\"font-weight: 600; font-size: 12.8px;\">Closures (areas fully closed to the public due to an active wildfire) change rapidly, and closure information on this page may not be up-to-date. If traveling to an area near an active wildfire, exercise extreme caution and always check public information on that particular wildfire.</span></div>\n         </calcite-accordion-item>\n         \n        <calcite-accordion-item heading=\"Central Area Restrictions\" class=\"headingPanel\" calcite-hydrated=\"\" scale=\"l\">\n            <div class=\"panel-body\" style=\"\"><h5><span style=\"font-weight: normal; font-size: 0.9rem;\">Also see statewide restrictions above,</span><span style=\"font-weight: normal;\">&nbsp;and Wasatch Front Area Restrictions below.</span></h5>\n            <p><span style=\"font-weight: 600;\">CLOSURE: Effective 2026-09-11</span>&nbsp;–&nbsp;<a href=\"https://drive.google.com/file/d/1kIN3LAgmg65VF3ODFQAYa1PQh3Hwj1vH/view?usp=drive_link\" style=\"background-color: rgb(240, 236, 212);\">Forest Service (USFS) - Manti-La Sal NF, Ferron RD (Black Canyon Rd)</a></p><p><span style=\"font-weight: 600;\">CLOSURE: Effective 2026-07-04</span>&nbsp;–&nbsp;<a href=\"https://www.fs.usda.gov/sites/nfs/files/r04/fishlake/publication/alerts/07-04%20Updated%20Cottonwood%20Fire-Closure%20Order%200408-26-07%20%281%29.pdf\" style=\"background-color: rgb(240, 236, 212);\">Forest Service (USFS) - Cottonwood Fire Closure</a></p><p><span style=\"font-weight: 600;\">CLOSURE: Effective 2026-06-27</span>&nbsp;–&nbsp;<a href=\"https://www.fs.usda.gov/sites/nfs/files/r04/fishlake/publication/alerts/Wild%20Goose%20Closure%20Order.pdf\" style=\"background-color: rgb(240, 236, 212);\">Forest Service (USFS) - Wild Goose Fire Closure</a></p><p><span style=\"font-weight: 600;\">CLOSURE: Effective 2026-06-26</span>&nbsp;–&nbsp;<a href=\"https://www.blm.gov/sites/default/files/docs/2026-06/BLM%20Cottonwood%20Fire%20Prevention%20Order%206-26-2026_0.pdf\" style=\"background-color: rgb(240, 236, 212);\">Bureau of Land Management (BLM) - Cottonwood Fire Closure</a></p>\n            </div>\n         </calcite-accordion-item>\n        \n         <calcite-accordion-item heading=\"Southeastern Utah Restrictions\" class=\"headingPanel\" calcite-hydrated=\"\" scale=\"l\"><div class=\"panel-body\" style=\"\"><h5><span style=\"font-weight: normal;\">Also see Southwestern Utah Restrictions below.</span></h5>\n            <p><span style=\"font-weight: 600;\">CLOSURE: Effective 2026-07-17</span>&nbsp;–&nbsp;<a href=\"https://drive.google.com/file/d/1yNQNJ5DiNGg8vIhYgpSGGXrvVgEUxQFC/view?usp=sharing\" style=\"background-color: rgb(240, 236, 212);\">Forest Service (USFS) - Babylon Fire Closure - Manti-La Sal NF (Monticello RD)</a></p><p><span style=\"font-weight: 600;\">STAGE 1: Effective 2026-06-10</span>&nbsp;–&nbsp;<a href=\"https://opvp.navajo-nsn.gov/wp-content/uploads/2026/07/executive-order-no-02-2026.pdf\" style=\"background-color: rgb(240, 236, 212);\">Navajo Nation</a></p><p><span style=\"font-weight: 600;\">PREVENTION ORDER: Effective 2026-05-18</span>&nbsp;–&nbsp;<a href=\"https://drive.google.com/file/d/1nOyGzOxOGw1p0UYvlDdKgRavIZtYGkZd/view\" style=\"background-color: rgb(240, 236, 212);\">Uintah and Ouray Indian Reservation</a></p>\n            </div>\n         </calcite-accordion-item>\n         \n         <calcite-accordion-item heading=\"Southwestern Utah Restrictions\" class=\"headingPanel\" calcite-hydrated=\"\" scale=\"l\">\n            <div class=\"panel-body\" style=\"\"><h5><span style=\"font-weight: normal;\">Also see statewide restrictions above.</span></h5>\n           <p><span style=\"font-weight: 600;\">CLOSURE: Effective 2026-07-04</span>&nbsp;–&nbsp;<a href=\"https://www.fs.usda.gov/sites/nfs/files/r04/fishlake/publication/alerts/07-04%20Updated%20Cottonwood%20Fire-Closure%20Order%200408-26-07%20%281%29.pdf\" style=\"background-color: rgb(240, 236, 212);\">Forest Service (USFS) - Cottonwood Fire Closure</a></p>\n            </div>\n         </calcite-accordion-item>\n         \n         <calcite-accordion-item heading=\"Wasatch Front Area Restrictions\" class=\"headingPanel\" calcite-hydrated=\"\" scale=\"l\">\n            <div class=\"panel-body\" style=\"\"><h5><span style=\"font-weight: normal;\">Also see statewide restrictions above.</span></h5>\n           <p><span style=\"font-weight: 600;\">STAGE 1: Effective 2026-06-19</span>&nbsp;–&nbsp;<a href=\"https://drive.google.com/file/d/1SpL8Q7C-gfIP6UKxyrW6sDG85gFH18HR/view\" style=\"background-color: rgb(240, 236, 212);\">State and Private Unincorporated - Morgan Co</a></p><p><span style=\"font-weight: 600;\">STAGE 1: Effective 2026-06-19</span>&nbsp;–&nbsp;<a href=\"https://drive.google.com/file/d/14nVmpN-S2jSXhFH7pl-hnmIFSa9moChC/view\" style=\"background-color: rgb(240, 236, 212);\">State and Private Unincorporated - Salt Lake Co</a></p><p><span style=\"font-weight: 600;\">NPS ORDER: Effective 2026-06-10</span>&nbsp;–&nbsp;<a href=\"https://drive.google.com/file/d/1QSjYSkPeeRuqZ5HGY6wYAALtwJOB7yRj/view\" style=\"background-color: rgb(240, 236, 212);\">State and Private Unincorporated - Lake Mtns</a></p><p><span style=\"font-weight: 600;\">SPECIAL ORDER: Effective 2026-06-15</span>&nbsp;–&nbsp;<a href=\"https://www.fs.usda.gov/r04/uinta-wasatch-cache/alerts/rock-canyon-camping-and-campfire-restrictions-pleasant-grove-ranger\" style=\"background-color: rgb(240, 236, 212);\">Forest Service (USFS) - Uinta-Wasatch-Cache NF (Pleasant Grove RD: Rock Canyon Area)</a></p><p><span style=\"font-weight: 600;\">SPECIAL ORDER: Effective 2026-04-01</span>&nbsp;–&nbsp;<a href=\"https://www.fs.usda.gov/r04/uinta-wasatch-cache/alerts/davis-county-fire-restrictions\" style=\"background-color: rgb(240, 236, 212);\">Forest Service (USFS) - Uinta-Wasatch-Cache NF (Davis Co. Bonneville Shoreline Bench)</a></p><p><span style=\"font-weight: 600;\">SPECIAL ORDER: Effective 2026-04-01</span>&nbsp;–&nbsp;<a href=\"https://www.fs.usda.gov/r04/uinta-wasatch-cache/alerts/farmington-and-ward-canyon-road-fire-restrictions\" style=\"background-color: rgb(240, 236, 212);\">Forest Service (USFS) - Uinta-Wasatch-Cache NF (Salt Lake RD: Farmington/Ward Cyn Rds)</a></p><p><span style=\"font-weight: 600;\">SPECIAL ORDER: Effective 2022-06-30</span>&nbsp;–&nbsp;<a href=\"https://www.fs.usda.gov/r04/uinta-wasatch-cache/alerts/american-fork-canyon-and-alpine-loop-camping-and-campfire\" style=\"background-color: rgb(240, 236, 212);\">Forest Service (USFS) - Uinta-Wasatch-Cache NF (Pleasant Grove RD: American Fork Canyon &amp; Alpine Loop)</a></p><p><span style=\"font-weight: 600;\">SPECIAL ORDER: Effective 2022-06-27</span>&nbsp;–&nbsp;<a href=\"https://www.fs.usda.gov/r04/uinta-wasatch-cache/alerts/silver-lake-flat-campfire-and-camping\" style=\"background-color: rgb(240, 236, 212);\">Forest Service (USFS) - Uinta-Wasatch-Cache NF (Pleasant Grove RD: Silver Lake Flat Area)</a></p><p><span style=\"font-weight: 600;\">SPECIAL ORDER: Effective 2022-06-22</span>&nbsp;–&nbsp;<a href=\"https://www.fs.usda.gov/r04/uinta-wasatch-cache/alerts/tibble-fork-area-campfire-closure\" style=\"background-color: rgb(240, 236, 212);\">Forest Service (USFS) - Uinta-Wasatch-Cache NF (Tibble Fork Reservoir)</a></p><p><span style=\"font-weight: 600;\">SPECIAL ORDER: Effective 1997-07-11</span>&nbsp;–&nbsp;<a href=\"https://www.fs.usda.gov/r04/uinta-wasatch-cache/alerts/camping-fire-restrictions-mill-creek-little-and-big-cottonwood\" style=\"background-color: rgb(240, 236, 212);\">Forest Service (USFS) - Uinta-Wasatch-Cache NF (Mill Creek, Little/Big Cottonwood, Emigration, &amp; Parleys Cyns)</a></p><p><span style=\"font-weight: 600;\">SPECIAL ORDER: Effective 1997-05-22</span>&nbsp;–&nbsp;<a href=\"https://www.fs.usda.gov/r04/uinta-wasatch-cache/alerts/mt-olympus-twin-peaks-lone-peak-and-deseret-peak-wilderness\" style=\"background-color: rgb(240, 236, 212);\">Forest Service (USFS) - Uinta-Wasatch-Cache NF (Mt. Olympus, Twin Peaks, Lone Peak, &amp; Deseret Peak Wildernesses)</a></p><p><span style=\"font-weight: 600;\">SPECIAL ORDER: Effective 1997-05-22</span>&nbsp;–&nbsp;<a href=\"https://www.fs.usda.gov/r04/uinta-wasatch-cache/alerts/camping-and-fire-restrictions-ferguson-canyon\" style=\"background-color: rgb(240, 236, 212);\">Forest Service (USFS) - Uinta-Wasatch-Cache NF (Salt Lake RD: Ferguson Cyn)</a></p><p><span style=\"font-weight: 600;\">SPECIAL ORDER: Effective 1996-02-28</span>&nbsp;–&nbsp;<a href=\"https://www.fs.usda.gov/r04/uinta-wasatch-cache/alerts/occupancy-and-use-mt-timpanogos-lone-peak-and-nt-nebo-wilderness\" style=\"background-color: rgb(240, 236, 212);\">Forest Service (USFS) - Uinta-Wasatch-Cache NF (Mt. Timpanogos Wilderness &amp; part of Lone Peak Wilderness)</a></p><p><span style=\"font-weight: 600;\">STAGE 1: Effective 2026-09-05</span>&nbsp;–&nbsp;<a href=\"https://drive.google.com/file/d/1zdfpngn54n6SBR7dfJQ0JFsQGaPRbWM7/view?usp=drive_link\" style=\"background-color: rgb(240, 236, 212);\">Bureau of Land Management (BLM) - West Desert District</a></p>\n            </div>\n         </calcite-accordion-item>\n         \n         <calcite-accordion-item heading=\"Northeastern Utah Restrictions\" class=\"headingPanel\" calcite-hydrated=\"\" scale=\"l\">\n            <div class=\"panel-body\" style=\"\"><h5><span style=\"font-weight: normal; font-size: 0.9rem;\">Also see statewide restrictions </span><span style=\"font-weight: normal;\">above.</span></h5>\n           <p><span style=\"font-weight: 600;\">STAGE 1: Effective 2026-09-04</span>&nbsp;–&nbsp;<a href=\"https://drive.google.com/file/d/1q_EkiO154bS8elzSaUPqu5QQsGrsTO0Q/view?usp=drive_link\" style=\"background-color: rgb(240, 236, 212);\">State and Private Unincorporated - Park City &amp; North Summit FDs</a></p><p><span style=\"font-weight: 600;\">SPECIAL ORDER: Effective 2026-05-05</span>&nbsp;–&nbsp;<a href=\"https://www.fs.usda.gov/r04/uinta-wasatch-cache/alerts/high-uinta-wilderness-area-campfire-restrictions-restricted-sites\" style=\"background-color: rgb(240, 236, 212);\">Forest Service (USFS) - Uinta-Wasatch-Cache NF (Around certain lakes/reservoirs in high Uintas)</a></p><p><span style=\"font-weight: 600;\">SPECIAL ORDER: Effective 2022-06-30</span>&nbsp;–&nbsp;<a href=\"https://www.fs.usda.gov/r04/uinta-wasatch-cache/alerts/american-fork-canyon-and-alpine-loop-camping-and-campfire\" style=\"background-color: rgb(240, 236, 212);\">Forest Service (USFS) - Uinta-Wasatch-Cache NF (Pleasant Grove RD: American Fork Canyon &amp; Alpine Loop)</a></p><p><span style=\"font-weight: 600;\">SPECIAL ORDER: Effective 1999-11-30</span>&nbsp;–&nbsp;<a href=\"https://www.fs.usda.gov/r04/uinta-wasatch-cache/alerts/primitivenon-motorizedrecreation-areas-order\" style=\"background-color: rgb(240, 236, 212);\">Forest Service (USFS) - Uinta-Wasatch-Cache NF (portions of Kamas RD)</a></p><p><span style=\"font-weight: 600;\">SPECIAL ORDER: Effective 1997-07-11</span>&nbsp;–&nbsp;<a href=\"https://www.fs.usda.gov/r04/uinta-wasatch-cache/alerts/camping-fire-restrictions-mill-creek-little-and-big-cottonwood\" style=\"background-color: rgb(240, 236, 212);\">Forest Service (USFS) - Uinta-Wasatch-Cache NF (Mill Creek, Little/Big Cottonwood, Emigration, &amp; Parleys Cyns)</a></p><p><span style=\"font-weight: 600;\">STAGE 1: Effective 2026-09-05</span>&nbsp;–&nbsp;<a href=\"https://drive.google.com/file/d/1zdfpngn54n6SBR7dfJQ0JFsQGaPRbWM7/view?usp=drive_link\" style=\"background-color: rgb(240, 236, 212);\">Bureau of Land Management (BLM) - West Desert District</a></p><p><span style=\"font-weight: 600;\">PREVENTION ORDER: Effective 2026-05-18</span>&nbsp;–&nbsp;<a href=\"https://drive.google.com/file/d/1nOyGzOxOGw1p0UYvlDdKgRavIZtYGkZd/view\" style=\"background-color: rgb(240, 236, 212);\">Uintah and Ouray Indian Reservation</a></p>\n            </div>\n         </calcite-accordion-item>\n         \n         <calcite-accordion-item heading=\"Northern Utah Restrictions\" class=\"headingPanel\" calcite-hydrated=\"\" scale=\"l\">\n            <div class=\"panel-body\" style=\"\"><h5><span style=\"font-size: 0.9rem; font-weight: normal;\">See&nbsp;</span><span style=\"font-weight: normal;\">Northeastern Utah Restrictions above for Summit County. Also see statewide restrictions above.</span></h5>\n           <p><span style=\"font-weight: 600;\">STAGE 1: Effective 2026-09-04</span>&nbsp;–&nbsp;<a href=\"https://drive.google.com/file/d/1q_EkiO154bS8elzSaUPqu5QQsGrsTO0Q/view?usp=drive_link\" style=\"background-color: rgb(240, 236, 212);\">State and Private Unincorporated - Park City &amp; North Summit FDs</a></p><p><span style=\"font-weight: 600;\">STAGE 1: Effective 2026-06-19</span>&nbsp;–&nbsp;<a href=\"https://drive.google.com/file/d/1SpL8Q7C-gfIP6UKxyrW6sDG85gFH18HR/view\" style=\"background-color: rgb(240, 236, 212);\">State and Private Unincorporated - Morgan Co</a></p><p><span style=\"font-weight: 600;\">STAGE 1: Effective 2026-07-01</span>&nbsp;–&nbsp;<a href=\"https://drive.google.com/file/d/1Ee8H01fGv6uZpMbA6poyrRbjvTM61Y8E/view?usp=sharing\" style=\"background-color: rgb(240, 236, 212);\">Forest Service (USFS) - Sawtooth NF (Minidoka RD)</a></p><p><span style=\"font-weight: 600;\">SPECIAL ORDER: Effective 2026-06-01</span>&nbsp;–&nbsp;<a href=\"https://www.fs.usda.gov/r04/uinta-wasatch-cache/alerts/fire-restrictions-weber-county\" style=\"background-color: rgb(240, 236, 212);\">Forest Service (USFS) - Uinta-Wasatch-Cache NF (Ogden RD: Weber Co Wasatch Foothills)</a></p><p><span style=\"font-weight: 600;\">SPECIAL ORDER: Effective 2026-04-01</span>&nbsp;–&nbsp;<a href=\"https://www.fs.usda.gov/r04/uinta-wasatch-cache/alerts/davis-county-fire-restrictions\" style=\"background-color: rgb(240, 236, 212);\">Forest Service (USFS) - Uinta-Wasatch-Cache NF (Davis Co. Bonneville Shoreline Bench)</a></p><p><span style=\"font-weight: 600;\">SPECIAL ORDER: Effective 2026-04-01</span>&nbsp;–&nbsp;<a href=\"https://www.fs.usda.gov/r04/uinta-wasatch-cache/alerts/farmington-and-ward-canyon-road-fire-restrictions\" style=\"background-color: rgb(240, 236, 212);\">Forest Service (USFS) - Uinta-Wasatch-Cache NF (Salt Lake RD: Farmington/Ward Cyn Rds)</a></p><p><span style=\"font-weight: 600;\">SPECIAL ORDER: Effective 2022-06-30</span>&nbsp;–&nbsp;<a href=\"https://www.fs.usda.gov/r04/uinta-wasatch-cache/alerts/pineview-reservoir-restrictions\" style=\"background-color: rgb(240, 236, 212);\">Forest Service (USFS) - Uinta-Wasatch-Cache NF (Pineview Reservoir)</a></p><p><span style=\"font-weight: 600;\">SPECIAL ORDER: Effective 2008-10-07</span>&nbsp;–&nbsp;<a href=\"https://www.fs.usda.gov/r04/uinta-wasatch-cache/alerts/tony-grove-lake-restrictions\" style=\"background-color: rgb(240, 236, 212);\">Forest Service (USFS) - Uinta-Wasatch-Cache NF (Logan RD: Tony Grove Area)</a></p><p><span style=\"font-weight: 600;\">SPECIAL ORDER: Effective 1997-07-07</span>&nbsp;–&nbsp;<a href=\"https://www.fs.usda.gov/r04/uinta-wasatch-cache/alerts/greenlogan-canyon-fire-and-firearms-restriction\" style=\"background-color: rgb(240, 236, 212);\">Forest Service (USFS) - Uinta-Wasatch-Cache NF (Logan RD: Green/Logan Cyn)</a></p><p><span style=\"font-weight: 600;\">SPECIAL ORDER: Effective 1997-04-02</span>&nbsp;–&nbsp;<a href=\"https://www.fs.usda.gov/r04/uinta-wasatch-cache/alerts/indian-trail-fire-restriction\" style=\"background-color: rgb(240, 236, 212);\">Forest Service (USFS) - Uinta-Wasatch-Cache NF (Ogden RD: Indian Trail &amp; Coldwater Trailhead)</a></p><p><span style=\"font-weight: 600;\">STAGE 1: Effective 2026-09-05</span>&nbsp;–&nbsp;<a href=\"https://drive.google.com/file/d/1zdfpngn54n6SBR7dfJQ0JFsQGaPRbWM7/view?usp=drive_link\" style=\"background-color: rgb(240, 236, 212);\">Bureau of Land Management (BLM) - West Desert District</a></p>\n            </div>\n         </calcite-accordion-item>\n         \n        </calcite-accordion>\n      </div></div>"}},"width":12}]}],"visibility":{"access":"default","groups":[]}},{"containment":"fixed","isFooter":false,"style":{"background":{"isFile":false,"isUrl":true,"state":"","display":{},"transparency":0,"position":{"x":"center","y":"center"},"color":"#ff3719"},"rowLayout":"box","color":"#000000"},"rows":[{"cards":[{"component":{"name":"markdown-card","settings":{"cardId":"cpnzfeii6","schemaVersion":2.1,"markdown":"<h1 style=\"text-align: center; font-size: 3rem;\">Fire Restriction Definitions</h1>"}},"width":12}]}],"visibility":{"access":"default","groups":[]}},{"containment":"fixed","isFooter":false,"style":{"background":{"isFile":false,"isUrl":true,"state":"","display":{},"transparency":0,"position":{"x":"center","y":"center"},"color":"#ffffff"},"color":"#000000","rowLayout":"box"},"rows":[{"cards":[{"component":{"name":"markdown-card","settings":{"cardId":"cj8bqvbut","schemaVersion":2.1,"markdown":"<p><b><i>The definitions below are generalized. Specifics of what is forbidden or allowed will vary slightly by agency, and between individual orders. Always read the active fire restrictions and check with the issuing authorities.</i></b></p><p><b><i><br></i></b></p><p><span style=\"font-style: italic; font-weight: 600;\">Information on municipal specific firework restrictions can be found here. </span><a href=\"https://firemarshal.utah.gov/department-services/fireworks-restricted-areas/\" style=\"background-color: rgb(255, 255, 255); color: rgb(0, 121, 193);\">https://firemarshal.utah.gov/department-services/fireworks-restricted-areas/</a></p>"}},"width":12}]},{"cards":[{"component":{"name":"markdown-card","settings":{"cardId":"cjew8uj5o","schemaVersion":2.1,"markdown":"<h2>Stage 1</h2><ol><span style=\"font-family: &quot;Helvetica Neue&quot;, Helvetica, sans-serif; font-size: 14px; background-color: rgb(255, 255, 0);\"></span><li>No open fires of any kind except within established public facilities in improved campgrounds, picnic areas. -OR- In permanently constructed fire pits at private homes where running water is present.</li><li>No smoking, except within an enclosed vehicle, trailer or building, a developed recreation site or while stopped in an area that is paved or free from dry vegetation.</li><li>No fireworks, tracer ammunition or other pyrotechnic devices including exploding targets.</li><li>No cutting, welding or grinding metal in areas of dry vegetation.</li><li>No operating a motorcycle, chainsaw, ATV, or other small internal combustion engine without an approved and working spark arrestor.</li><span style=\"font-family: &quot;Helvetica Neue&quot;, Helvetica, sans-serif; font-size: 14px; background-color: rgb(255, 255, 0);\"></span></ol>\n  \n  "}},"width":6},{"component":{"name":"markdown-card","settings":{"cardId":"cggcppyio","schemaVersion":2.1,"markdown":"<h2>Stage 2</h2><p>NO OPEN FIRES OF ANY KIND - Devices using pressurized liquid or gas fuels (stoves, grills, or lanterns) with a shut-off valve are allowed when used at least 3 feet from flammable material.</p><p style=\"text-align: center;\"><b>- PLUS -</b></p><p style=\"text-align: left;\">All of the restricted activities listed under <b>Stage 1</b>.</p>"}},"width":6}]}],"visibility":{"access":"default","groups":[]}},{"containment":"fixed","isFooter":false,"style":{"background":{"isFile":false,"isUrl":true,"state":"","display":{},"transparency":0,"position":{"x":"center","y":"center"},"color":"#f3ab00"},"color":"#000000","rowLayout":"box"},"rows":[{"cards":[{"component":{"name":"markdown-card","settings":{"cardId":"cx2mo4xg4","schemaVersion":2.1,"markdown":"<h1 style=\"text-align: center; font-size: 3rem;\">Burn Permits</h1>"}},"width":12}]}],"visibility":{"access":"default","groups":[]}},{"containment":"fixed","isFooter":false,"style":{"background":{"isFile":false,"isUrl":true,"state":"","display":{},"transparency":0,"position":{"x":"center","y":"center"},"color":"transparent"},"rowLayout":"box"},"rows":[{"cards":[{"component":{"name":"markdown-card","settings":{"cardId":"chb5mqhsk","schemaVersion":2.1,"markdown":"<p><a href=\"https://ffsl.utah.gov/wildland-fire/burn-permits/\">Private Land Burn Permit Information</a></p>"}},"width":6},{"component":{"name":"markdown-card","settings":{"cardId":"ccgjuxwsr","schemaVersion":1,"markdown":""}},"width":6}]}],"visibility":{"access":"default","groups":[]}},{"containment":"fixed","isFooter":false,"style":{"background":{"isFile":false,"isUrl":true,"state":"","display":{},"transparency":0,"position":{"x":"center","y":"center"},"color":"transparent"},"rowLayout":"box"},"rows":[{"cards":[{"component":{"name":"markdown-card","settings":{"cardId":"cwx08f52g","schemaVersion":2.1,"markdown":"<style>\r\n/*Formatting text, please do not remove*/\r\n@import url('https://fonts.googleapis.com/css2?family=Poppins:wght@500;600;700;800&display=swap');\r\n\r\n.navbar-title{\r\n  font-family: 'Archivo Black' !important;\r\n}\r\n.responsive-tabs-nav li{\r\n  font-weight: 700 !important;\r\n}\r\n\r\n</style>"}},"width":12}]}],"visibility":{"access":"default","groups":[]}}]},"updatedAt":"2026-09-30T17:03:41.046Z","updatedBy":"gsvobodny_ffsl"}}